# Local deployment configuration. Versioned inputs, not the runtime file.
# Credentials below are development-only defaults. Never use them in staging/production.
# After generation, edit .env.local directly for personal settings.

# ── Environment ───────────────────────────────────────────────
# Set according to target: local | staging | production
ENV=local

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_PORT=4200
PUBLIC_BACKEND_URL=http://localhost:8080/v1
PUBLIC_FILE_STORAGE_URL=http://localhost:8080/v1/files

# ── Database ──────────────────────────────────────────────────
DB_USER=ductifact_local_user
DB_PASSWORD=local-db-password
DB_NAME=ductifact_local_db

# ── Backend ───────────────────────────────────────────────────
BACKEND_HOST=localhost
BACKEND_PORT=8080
JWT_SECRET=local-only-jwt-signing-secret-32-characters
JWT_ACCESS_TOKEN_TTL_SECONDS=900 # 15 min
JWT_REFRESH_TOKEN_TTL_SECONDS=604800 # 7 days
# Frontend origins allowed to call this API (comma-separated)
CORS_ORIGINS=*
LOG_LEVEL=debug
LOG_FORMAT=text
GIN_MODE=debug

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_IP_MAX=10000
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_USER_MAX=10000
RATE_LIMIT_USER_WINDOW_SECONDS=60

# ── Login throttle ────────────────────────────────────────────
LOGIN_THROTTLE_MAX_ATTEMPTS=100
LOGIN_THROTTLE_WINDOW_SECONDS=60
LOGIN_THROTTLE_LOCKOUT_SECONDS=60

# ── S3-compatible object storage (RustFS) ─────────────────────
S3_ACCESS_KEY=local-access-key
S3_SECRET_KEY=local-storage-secret
S3_BUCKET=ductifact-local
S3_CONSOLE_PORT=9001

# ── SMTP (email) ──────────────────────────────────────────────
# SMTP runs outside this stack; set a reachable endpoint in .env.local.
SMTP_HOST=host.docker.internal
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_USERNAME=unused
SMTP_PASSWORD=unused
SMTP_FROM=noreply@ductifact.local

# ── Redis (distributed state) ─────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=true
REDIS_PASSWORD=local-redis-password
REDIS_DB=0

# ── Monitoring ────────────────────────────────────────────────
GRAFANA_PORT=3000
PROMETHEUS_RETENTION=7d

# ── One-time OTP codes ────────────────────────────────────────
VERIFICATION_REGISTRATION_OTP_TTL_SECONDS=900 #15 min
VERIFICATION_PASSWORD_RESET_OTP_TTL_SECONDS=900 # 15 min
