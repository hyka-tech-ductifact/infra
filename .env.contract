# Contract for runtime environment files.
# Defines required variables and identifies secrets with SECRET_IN_GITHUB_ENV.
# Values below document the variables; they are not runtime defaults.
# Generate runtime files with scripts/ops/generate_env.sh; do not copy this file.

# ── Environment ───────────────────────────────────────────────
# Set according to target: local | staging | production
ENV=local

# ── Application images               ───────────────────────────
BACKEND_IMAGE=backend-app
FRONTEND_IMAGE=frontend-app

# ── Shared platform images ─────────────────────────────────────
POSTGRES_IMAGE=postgres:15-alpine@sha256:CHANGE_ME
S3_IMAGE=docker.io/rustfs/rustfs:1.0.4@sha256:CHANGE_ME
REDIS_IMAGE=redis:7-alpine@sha256:CHANGE_ME
PROMETHEUS_IMAGE=prom/prometheus:v3.3.0@sha256:CHANGE_ME
GRAFANA_IMAGE=grafana/grafana:11.6.0@sha256:CHANGE_ME

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_PORT=4200
PUBLIC_BACKEND_URL=http://localhost:8080/v1
PUBLIC_FILE_STORAGE_URL=http://localhost:8080/v1/files

# ── Database ──────────────────────────────────────────────────
DB_USER=ductifact_ENV_user
DB_PASSWORD=SECRET_IN_GITHUB_ENV
DB_NAME=ductifact_ENV_db

# ── Backend ───────────────────────────────────────────────────
BACKEND_HOST=localhost
BACKEND_PORT=8080
JWT_SECRET=SECRET_IN_GITHUB_ENV
JWT_ACCESS_TOKEN_TTL_SECONDS=900 # 15 min
JWT_REFRESH_TOKEN_TTL_SECONDS=604800 # 7 days
# Frontend origins allowed to call this API (comma-separated)
CORS_ORIGINS=*
LOG_LEVEL=debug
LOG_FORMAT=text
GIN_MODE=debug

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_IP_MAX=10000
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_USER_MAX=10000
RATE_LIMIT_USER_WINDOW_SECONDS=60

# ── Login throttle ────────────────────────────────────────────
LOGIN_THROTTLE_MAX_ATTEMPTS=100
LOGIN_THROTTLE_WINDOW_SECONDS=60
LOGIN_THROTTLE_LOCKOUT_SECONDS=60

# ── S3-compatible object storage (RustFS) ─────────────────────
S3_ACCESS_KEY=SECRET_IN_GITHUB_ENV
S3_SECRET_KEY=SECRET_IN_GITHUB_ENV
S3_BUCKET=ductifact_ENV
S3_CONSOLE_PORT=9001

# ── SMTP (email) ──────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_USERNAME=SECRET_IN_GITHUB_ENV
SMTP_PASSWORD=SECRET_IN_GITHUB_ENV
SMTP_FROM=noreply@ductifact.local

# ── Redis (distributed state) ─────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=true
REDIS_PASSWORD=SECRET_IN_GITHUB_ENV
REDIS_DB=0

# ── Monitoring ────────────────────────────────────────────────
GRAFANA_PORT=3000
PROMETHEUS_RETENTION=7d

# ── One-time OTP codes ────────────────────────────────────────
VERIFICATION_REGISTRATION_OTP_TTL_SECONDS=900 #15 min
VERIFICATION_PASSWORD_RESET_OTP_TTL_SECONDS=900 # 15 min
